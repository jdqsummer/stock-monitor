# dsh-engine 专属 .dockerignore（BuildKit 对 dsh-engine/Dockerfile 生效，覆盖根 .dockerignore）
# 根 .dockerignore 为 backend `COPY . .` 排除了 .dsh/、scripts/ 等 DSH 资产；
# dsh-engine 需要显式 COPY .dsh / scripts/dsh_p3 / backend，故此处重新纳入这些路径，
# 仅排除真正不需要的大文件与运行时产物。

# Git
.git
.gitignore

# Python 缓存
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Node（插件/SDK 各自的 node_modules 运行时产物，不进镜像）
node_modules/
**/node_modules/

# 数据库与配置（运行时注入）
*.db
*.sqlite3
.env
.env.local

# DSH 运行时产物（headless 会话日志 / home 目录）
.dsh-home/
**/.dsh-home/
_session_*.jsonl
**/_session_*.jsonl

# P0 验证资产（SDK clone 889M + 便携 node + 会话日志，dsh-engine 只需要 dsh_p3）
scripts/dsh_p0/

# 与 dsh-engine 无关的目录
frontend/
docs/
tests/
.superpowers/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

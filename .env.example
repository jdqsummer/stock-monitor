# stock-monitor/.env.example
DATABASE_URL=sqlite+aiosqlite:///./stock_monitor.db
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REDIS_URL=redis://localhost:6379/0

# DeepSeek LLM（get_llm 读 LLM_MODEL/LLM_API_KEY；记忆蒸馏兜底读 DEEPSEEK_API_KEY）
LLM_MODEL=deepseek:deepseek-chat
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# DSH 分析引擎（P3 桥接，五段式 LLM 定性 + 确定性计算双实现收敛 I4）
# 总开关：DSH_ENABLED=false 时即便配置了 LLM provider 也走纯规则降级链
DSH_ENABLED=true
# dsh-engine HTTP 触发端点 + 确定性计算端点（compose 内置服务名 dsh-engine）
DSH_ENGINE_URL=http://dsh-engine:8001
DSH_CALC_URL=http://dsh-engine:8002
# 单次五段分析超时（5 个 agent() 串行 ~10min，默认 1800s 覆盖整次）
DSH_TIMEOUT_SECONDS=1800
# 整体重试次数（默认 1，首试失败后重试 1 次共 2 次）
DSH_RETRY_COUNT=1
# 默认模型（用户选 LLM 时未指定则用此）；用户确认默认 openrouter:minimax/minimax-m2.7:free（m3 五段 schema 校验失败）
DSH_MODEL_DEFAULT=openrouter:minimax/minimax-m2.7:free
# 单次分析 input+output token 预算阈值（超限降级）
DSH_BUDGET_PER_ANALYSIS=100000
# 日累计上限（超限拒绝新分析）
DSH_DAILY_BUDGET=1000000
# S6 熔断：连续失败次数阈值 + 冷却期
DSH_CIRCUIT_BREAK_THRESHOLD=3
DSH_CIRCUIT_COOLDOWN_SECONDS=300
# S3 会话日志留存（热存储天数 + 会话数上限 + 清理间隔秒数）
DSH_SESSION_RETENTION_DAYS=90
DSH_SESSION_MAX_COUNT=10000
DSH_CLEANUP_INTERVAL_SECONDS=86400
# DSH 工具调用模式（native 走 dsh 原生，composite 走 invest-* 插件）
DSH_TOOLS_MODE=native
# OpenRouter（免费档多供应商聚合；走 dsh-llm-pi-ai 的 openrouter route）
# 不填则五段/聊天走 deepseek-v4-flash 兜底；m2.7:free 默认模型需此 key
OPENROUTER_API_KEY=

# Email (SMTP) — QQ 邮箱示例：465 + SSL（aiosmtplib use_tls 隐式 SSL，必须用 465）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your-email@qq.com

# 数据源优先级链（逗号分隔，依次尝试；默认 mock 表示开发期模拟数据）
DATA_PROVIDER_PRIORITY=tencent,eastmoney,mock
